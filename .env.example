# OptiVMAF Ympäristömuuttujat (esimerkki)
# Kopioi tämä tiedosto nimelle .env: cp .env.example .env

# Web-käyttöliittymän portti isännässä
PORT=6699

# Polut isäntäkoneella videokansioille
MEDIA_INPUT=/mnt/media/pakkaa
MEDIA_OUTPUT=/mnt/media/valmiit
MEDIA_TEMP=/mnt/media/temp

# Valinnainen: VAAPI-laitteen polku isännässä (oletus /dev/dri)
DRI_PATH=/dev/dri
